#!/usr/bin/env bash
# `ainar` — the AINAR course model CLI, in TypeScript, run straight from source.
#
#   bin/ainar validate CSS-4008 --root workspace
#   bin/ainar inbox CSS-4008-2026-FALL --root /path/to/workspace
#   cd workspace && ../bin/ainar validate CSS-4008
#
# No build step: Node strips the type annotations and runs the .ts files. That
# is how the upstream project runs it too (`npm run ainar` in ainar-node), so
# there is no compiled copy here to fall out of step with the source.
#
# --experimental-strip-types is required on Node 22 and is the default from
# Node 23. It handles type annotations only, which is all this code uses.
#
# The workspace is `--root <path>`, or the directory you are standing in.
# AINAR_WORKSPACE is not read — see README.
#
# This checkout's own example course is under `workspace/`, and the repository
# root is not a workspace, so running this from the root without `--root` finds
# no courses — exactly as it would in any other folder that has no `courses/`
# in it. That was not true before 2026-09-17, when the example course sat at the
# root; a script written then and not passing `--root` will now come up empty.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# The same harness home `bin/sample` uses, so that a token typed into the pane
# is the token this CLI finds.
#
# The pane writes credentials through the harness's credential seam, which
# stores them in $DSH_HOME/.credentials.yaml. `bin/sample` points DSH_HOME at
# THIS checkout's .dsh; without the same line here, `ainar` would fall back to
# ~/.dsh and report no token while the pane showed one saved — the two-surfaces
# -disagree failure the connections registry exists to end.
#
# Only when unset, unlike `bin/sample`, which sets it unconditionally because
# the profile it boots can only be found there. Here an exported DSH_HOME is a
# deliberate choice about which harness home to read, and there is no profile
# to lose by honouring it.
if [ -z "${DSH_HOME:-}" ] && [ -d "$here/.dsh" ]; then
  export DSH_HOME="$here/.dsh"
fi

exec node --experimental-strip-types "$here/ainar-node/bin/ainar.ts" "$@"
