#!/usr/bin/env bash
# `deck` — slide decks: `ainar deck fit | check | render`.
#
#   bin/deck render courses/CSS-4007/materials/MODULE-01-slides/MODULE-01-slides.md --pdf
#   bin/deck render --document DOC-DECK-SRC-01 --course-version CSS-4007-2026-FALL --pdf
#   bin/deck check  work/CSS-4007-2026-FALL/materials/MODULE-08-slides/MODULE-08-slides.md
#
# A first argument that is a flag means the old form, `bin/deck --document …`,
# from when this launched render-deck; it is read as `render`. See bin/deck.cmd
# for why this launcher exists at all.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [ -z "${SOFFICE_PATH:-}" ]; then
  for candidate in \
    "/c/Program Files/LibreOffice/program/soffice.exe" \
    "/c/Program Files (x86)/LibreOffice/program/soffice.exe" \
    "/usr/bin/soffice" \
    "/Applications/LibreOffice.app/Contents/MacOS/soffice"; do
    if [ -x "$candidate" ]; then export SOFFICE_PATH="$candidate"; break; fi
  done
fi
case "${1:-}" in
  --*) set -- render "$@" ;;
esac
exec node --experimental-strip-types "$here/ainar-node/bin/ainar.ts" deck "$@"