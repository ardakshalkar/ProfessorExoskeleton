{
  "$defs": {
    "AssessmentBlueprintCell": {
      "additionalProperties": false,
      "description": "One allocation in an assessment design matrix.\n\nThe cell makes the intended balance reviewable before questions are\nwritten: outcome x cognitive level x difficulty x item type.",
      "properties": {
        "extensions": {
          "additionalProperties": true,
          "description": "Faculty- or department-specific fields outside the common core.",
          "title": "Extensions",
          "type": "object"
        },
        "outcome_id": {
          "pattern": "^LO-[0-9]{2,3}$",
          "title": "Outcome Id",
          "type": "string"
        },
        "cognitive_level": {
          "$ref": "#/$defs/CognitiveLevel"
        },
        "difficulty": {
          "$ref": "#/$defs/ItemDifficulty"
        },
        "item_type": {
          "$ref": "#/$defs/ItemType"
        },
        "item_count": {
          "minimum": 1,
          "title": "Item Count",
          "type": "integer"
        },
        "marks": {
          "exclusiveMinimum": 0,
          "title": "Marks",
          "type": "number"
        }
      },
      "required": [
        "outcome_id",
        "cognitive_level",
        "difficulty",
        "item_type",
        "item_count",
        "marks"
      ],
      "title": "AssessmentBlueprintCell",
      "type": "object"
    },
    "AssessmentDesign": {
      "additionalProperties": false,
      "description": "The professor-approved shape of an assessment, before item writing.",
      "properties": {
        "extensions": {
          "additionalProperties": true,
          "description": "Faculty- or department-specific fields outside the common core.",
          "title": "Extensions",
          "type": "object"
        },
        "purpose": {
          "description": "e.g. diagnostic, formative, midterm, final.",
          "title": "Purpose",
          "type": "string"
        },
        "duration_minutes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Minutes"
        },
        "target_item_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Item Count"
        },
        "cells": {
          "items": {
            "$ref": "#/$defs/AssessmentBlueprintCell"
          },
          "title": "Cells",
          "type": "array"
        },
        "constraints": {
          "additionalProperties": true,
          "description": "Professor constraints such as allowed aids or item-type limits.",
          "title": "Constraints",
          "type": "object"
        }
      },
      "required": [
        "purpose"
      ],
      "title": "AssessmentDesign",
      "type": "object"
    },
    "AssessmentType": {
      "enum": [
        "assignment",
        "quiz",
        "exam",
        "project",
        "presentation",
        "oral_defense",
        "participation",
        "other"
      ],
      "title": "AssessmentType",
      "type": "string"
    },
    "CognitiveLevel": {
      "description": "Bloom-style cognitive level of a learning outcome.",
      "enum": [
        "remember",
        "understand",
        "apply",
        "analyze",
        "evaluate",
        "create"
      ],
      "title": "CognitiveLevel",
      "type": "string"
    },
    "CriterionLevel": {
      "additionalProperties": false,
      "description": "One performance band of a rubric criterion.",
      "properties": {
        "extensions": {
          "additionalProperties": true,
          "description": "Faculty- or department-specific fields outside the common core.",
          "title": "Extensions",
          "type": "object"
        },
        "score": {
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "description": {
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "score",
        "description"
      ],
      "title": "CriterionLevel",
      "type": "object"
    },
    "DeliveryChannel": {
      "description": "Where the work arrives, which is not the same as what shape it is in.\n\n``SubmissionFormat`` answers \"what is handed in\" — a PDF, a notebook, a\nrepository. This answers \"how does it reach me\", and the two are independent:\na notebook can arrive as a Canvas upload or as a pushed commit, and the tools\nthat can act on it differ completely.\n\nIt is a core field rather than an extension because it decides which import\npath exists at all. ``lms push`` needs a Canvas assignment id;\n``import-graded-exam`` needs the paper question map; an oral defence produces\nno artefact for either to attach to, and that is a legitimate state rather\nthan missing work. The validator checks each channel against the\nconfiguration it implies, which is the whole reason for writing it down.",
      "enum": [
        "canvas_upload",
        "github_repo",
        "paper_exam",
        "oral_defense",
        "presentation",
        "instructor_collected",
        "other"
      ],
      "title": "DeliveryChannel",
      "type": "string"
    },
    "ItemDifficulty": {
      "description": "How hard the professor *intended* an item to be.\n\nDistinct from observed difficulty, which ``ainar score-items`` computes from\nwhat the class actually did. Both are worth having precisely because they\ndisagree: an item declared ``easy`` that a third of the class fails is either\na badly worded question or a topic that did not land, and neither is visible\nfrom the success rate alone.",
      "enum": [
        "easy",
        "medium",
        "complex"
      ],
      "title": "ItemDifficulty",
      "type": "string"
    },
    "ItemType": {
      "description": "Shape of a single question or task inside an assessment.",
      "enum": [
        "multiple_choice",
        "multiple_select",
        "true_false",
        "short_answer",
        "numeric",
        "essay",
        "code",
        "practical",
        "other"
      ],
      "title": "ItemType",
      "type": "string"
    },
    "Rubric": {
      "additionalProperties": false,
      "description": "A set of criteria used to evaluate submissions of an assessment.",
      "properties": {
        "extensions": {
          "additionalProperties": true,
          "description": "Faculty- or department-specific fields outside the common core.",
          "title": "Extensions",
          "type": "object"
        },
        "rubric_id": {
          "pattern": "^RUBRIC-[A-Z0-9][A-Z0-9-]*$",
          "title": "Rubric Id",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/RubricCriterion"
          },
          "title": "Criteria",
          "type": "array"
        }
      },
      "required": [
        "rubric_id"
      ],
      "title": "Rubric",
      "type": "object"
    },
    "RubricCriterion": {
      "additionalProperties": false,
      "description": "One line of a rubric.\n\nThe link from criterion to outcome and capability is what turns grading\ninto evidence. Without it AINAR can compute marks but cannot build a\ncapability map.",
      "properties": {
        "extensions": {
          "additionalProperties": true,
          "description": "Faculty- or department-specific fields outside the common core.",
          "title": "Extensions",
          "type": "object"
        },
        "criterion_id": {
          "pattern": "^CRIT-[A-Z0-9][A-Z0-9-]*$",
          "title": "Criterion Id",
          "type": "string"
        },
        "rubric_id": {
          "pattern": "^RUBRIC-[A-Z0-9][A-Z0-9-]*$",
          "title": "Rubric Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "maximum_score": {
          "exclusiveMinimum": 0,
          "title": "Maximum Score",
          "type": "number"
        },
        "weight": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight"
        },
        "outcome_id": {
          "anyOf": [
            {
              "pattern": "^LO-[0-9]{2,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome Id"
        },
        "capability_id": {
          "anyOf": [
            {
              "pattern": "^CAP-[A-Z0-9][A-Z0-9-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability Id"
        },
        "concepts": {
          "items": {
            "type": "string"
          },
          "title": "Concepts",
          "type": "array"
        },
        "levels": {
          "items": {
            "$ref": "#/$defs/CriterionLevel"
          },
          "title": "Levels",
          "type": "array"
        }
      },
      "required": [
        "criterion_id",
        "rubric_id",
        "title",
        "maximum_score"
      ],
      "title": "RubricCriterion",
      "type": "object"
    },
    "SubmissionFormat": {
      "enum": [
        "pdf",
        "docx",
        "pptx",
        "notebook",
        "code_repo",
        "audio",
        "video",
        "image",
        "url",
        "text",
        "oral_defense"
      ],
      "title": "SubmissionFormat",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A graded task: assignment, quiz, exam, project, presentation, defense.",
  "properties": {
    "extensions": {
      "additionalProperties": true,
      "description": "Faculty- or department-specific fields outside the common core.",
      "title": "Extensions",
      "type": "object"
    },
    "assessment_id": {
      "pattern": "^ASSESSMENT-[A-Z0-9][A-Z0-9-]*$",
      "title": "Assessment Id",
      "type": "string"
    },
    "course_version_id": {
      "pattern": "^[A-Z][A-Z0-9]{1,7}-[0-9]{3,5}-[0-9]{4}-(?:FALL|SPRING|SUMMER|WINTER)$",
      "title": "Course Version Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/AssessmentType"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "module_id": {
      "anyOf": [
        {
          "pattern": "^MODULE-(?:DRAFT-)?[0-9]{2,3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Module Id"
    },
    "maximum_score": {
      "default": 100,
      "exclusiveMinimum": 0,
      "title": "Maximum Score",
      "type": "number"
    },
    "weight": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Share of the final grade; run weights should sum to 1.0.",
      "title": "Weight"
    },
    "opens_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Opens At"
    },
    "due_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Due At"
    },
    "outcomes": {
      "items": {
        "pattern": "^LO-[0-9]{2,3}$",
        "type": "string"
      },
      "title": "Outcomes",
      "type": "array"
    },
    "rubric_id": {
      "anyOf": [
        {
          "pattern": "^RUBRIC-[A-Z0-9][A-Z0-9-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rubric Id"
    },
    "rubric": {
      "anyOf": [
        {
          "$ref": "#/$defs/Rubric"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Inline rubric; preferred when the rubric is not reused."
    },
    "submission_type": {
      "items": {
        "$ref": "#/$defs/SubmissionFormat"
      },
      "title": "Submission Type",
      "type": "array"
    },
    "delivery": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeliveryChannel"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Where the work arrives — a Canvas upload, a pushed repository, a paper booklet, an oral defence. Decides which import path exists; see DeliveryChannel."
    },
    "instructions_document_id": {
      "anyOf": [
        {
          "pattern": "^DOC-[A-Z0-9][A-Z0-9-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Instructions Document Id"
    },
    "settings": {
      "additionalProperties": true,
      "description": "Type-specific configuration that does not belong in the common core, e.g. anonymous_grading, allow_late_submission, ai_review.",
      "title": "Settings",
      "type": "object"
    },
    "design": {
      "anyOf": [
        {
          "$ref": "#/$defs/AssessmentDesign"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Multidimensional blueprint agreed before item generation."
    }
  },
  "required": [
    "assessment_id",
    "course_version_id",
    "title",
    "type"
  ],
  "title": "Assessment",
  "type": "object"
}
