{
  "$defs": {
    "Provenance": {
      "additionalProperties": false,
      "description": "Where an AI-produced statement came from.\n\nEvery AI conclusion must be reconstructable: which data, which model,\nwhich workflow version, what evidence, who approved it.",
      "properties": {
        "extensions": {
          "additionalProperties": true,
          "description": "Faculty- or department-specific fields outside the common core.",
          "title": "Extensions",
          "type": "object"
        },
        "produced_by": {
          "description": "Agent or workflow that produced this output.",
          "title": "Produced By",
          "type": "string"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "workflow_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workflow Version"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "input_refs": {
          "description": "Identifiers of the records and documents used as input.",
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        }
      },
      "required": [
        "produced_by"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SignalStatus": {
      "enum": [
        "open",
        "acknowledged",
        "resolved",
        "dismissed"
      ],
      "title": "SignalStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Something that may deserve the professor's attention.\n\nA signal without evidence is a label. AINAR does not emit labels such as\n\"weak student\"; every signal carries the evidence that produced it.",
  "properties": {
    "extensions": {
      "additionalProperties": true,
      "description": "Faculty- or department-specific fields outside the common core.",
      "title": "Extensions",
      "type": "object"
    },
    "signal_id": {
      "pattern": "^SIGNAL-[A-Z0-9][A-Z0-9-]*$",
      "title": "Signal Id",
      "type": "string"
    },
    "student_id": {
      "anyOf": [
        {
          "pattern": "^STUDENT-[A-Z0-9][A-Z0-9-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Omit for class-level signals.",
      "title": "Student Id"
    },
    "course_version_id": {
      "pattern": "^[A-Z][A-Z0-9]{1,7}-[0-9]{3,5}-[0-9]{4}-(?:FALL|SPRING|SUMMER|WINTER)$",
      "title": "Course Version Id",
      "type": "string"
    },
    "type": {
      "description": "e.g. 'repeated_concept_difficulty', 'missing_submissions'.",
      "title": "Type",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/Severity",
      "default": "medium"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "pattern": "^EVID-[A-Z0-9][A-Z0-9-]*$",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "concepts": {
      "items": {
        "pattern": "^CONCEPT-[A-Z0-9][A-Z0-9-]*$",
        "type": "string"
      },
      "title": "Concepts",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/SignalStatus",
      "default": "open"
    },
    "detected_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detected At"
    },
    "provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/Provenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "signal_id",
    "course_version_id",
    "type",
    "description"
  ],
  "title": "StudentSignal",
  "type": "object"
}
