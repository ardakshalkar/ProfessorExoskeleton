{
  "$defs": {
    "ActivityType": {
      "enum": [
        "lecture",
        "lab",
        "seminar",
        "discussion",
        "reading",
        "exercise",
        "project_work",
        "field_work",
        "review",
        "other"
      ],
      "title": "ActivityType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A scheduled teaching event: lecture, lab, seminar, reading, exercise.",
  "properties": {
    "extensions": {
      "additionalProperties": true,
      "description": "Faculty- or department-specific fields outside the common core.",
      "title": "Extensions",
      "type": "object"
    },
    "activity_id": {
      "pattern": "^ACT-[A-Z0-9][A-Z0-9-]*$",
      "title": "Activity Id",
      "type": "string"
    },
    "course_version_id": {
      "pattern": "^[A-Z][A-Z0-9]{1,7}-[0-9]{3,5}-[0-9]{4}-(?:FALL|SPRING|SUMMER|WINTER)$",
      "title": "Course Version Id",
      "type": "string"
    },
    "module_id": {
      "anyOf": [
        {
          "pattern": "^MODULE-(?:DRAFT-)?[0-9]{2,3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Module Id"
    },
    "type": {
      "$ref": "#/$defs/ActivityType"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "scheduled_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scheduled At"
    },
    "duration_minutes": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Minutes"
    },
    "location": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Location"
    },
    "outcomes": {
      "items": {
        "pattern": "^LO-[0-9]{2,3}$",
        "type": "string"
      },
      "title": "Outcomes",
      "type": "array"
    },
    "concepts": {
      "items": {
        "pattern": "^CONCEPT-[A-Z0-9][A-Z0-9-]*$",
        "type": "string"
      },
      "title": "Concepts",
      "type": "array"
    },
    "resources": {
      "items": {
        "pattern": "^RES-[A-Z0-9][A-Z0-9-]*$",
        "type": "string"
      },
      "title": "Resources",
      "type": "array"
    },
    "preparation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "What students should do before the activity.",
      "title": "Preparation"
    }
  },
  "required": [
    "activity_id",
    "course_version_id",
    "type",
    "title"
  ],
  "title": "LearningActivity",
  "type": "object"
}
