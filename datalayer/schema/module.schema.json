{
  "additionalProperties": false,
  "description": "A teaching unit — typically one week of the course.",
  "properties": {
    "extensions": {
      "additionalProperties": true,
      "description": "Faculty- or department-specific fields outside the common core.",
      "title": "Extensions",
      "type": "object"
    },
    "module_id": {
      "pattern": "^MODULE-(?:DRAFT-)?[0-9]{2,3}$",
      "title": "Module Id",
      "type": "string"
    },
    "course_id": {
      "pattern": "^[A-Z][A-Z0-9]{1,7}-[0-9]{3,5}$",
      "title": "Course Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "week": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Week"
    },
    "order": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Order"
    },
    "outcomes": {
      "items": {
        "pattern": "^LO-[0-9]{2,3}$",
        "type": "string"
      },
      "title": "Outcomes",
      "type": "array"
    },
    "concepts": {
      "items": {
        "pattern": "^CONCEPT-[A-Z0-9][A-Z0-9-]*$",
        "type": "string"
      },
      "title": "Concepts",
      "type": "array"
    },
    "estimated_hours": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Estimated Hours"
    }
  },
  "required": [
    "module_id",
    "course_id",
    "title"
  ],
  "title": "Module",
  "type": "object"
}
