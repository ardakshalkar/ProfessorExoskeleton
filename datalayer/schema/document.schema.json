{
  "$defs": {
    "PresentationPlan": {
      "additionalProperties": false,
      "description": "A reviewable deck plan stored with the generated document metadata.",
      "properties": {
        "extensions": {
          "additionalProperties": true,
          "description": "Faculty- or department-specific fields outside the common core.",
          "title": "Extensions",
          "type": "object"
        },
        "audience": {
          "title": "Audience",
          "type": "string"
        },
        "style": {
          "description": "Reusable profile name such as lecture or workshop.",
          "title": "Style",
          "type": "string"
        },
        "duration_minutes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Minutes"
        },
        "max_slides": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Slides"
        },
        "outcomes": {
          "items": {
            "pattern": "^LO-[0-9]{2,3}$",
            "type": "string"
          },
          "title": "Outcomes",
          "type": "array"
        },
        "concepts": {
          "items": {
            "pattern": "^CONCEPT-[A-Z0-9][A-Z0-9-]*$",
            "type": "string"
          },
          "title": "Concepts",
          "type": "array"
        },
        "slides": {
          "items": {
            "$ref": "#/$defs/SlideSpecification"
          },
          "minItems": 1,
          "title": "Slides",
          "type": "array"
        }
      },
      "required": [
        "audience",
        "style",
        "slides"
      ],
      "title": "PresentationPlan",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where an AI-produced statement came from.\n\nEvery AI conclusion must be reconstructable: which data, which model,\nwhich workflow version, what evidence, who approved it.",
      "properties": {
        "extensions": {
          "additionalProperties": true,
          "description": "Faculty- or department-specific fields outside the common core.",
          "title": "Extensions",
          "type": "object"
        },
        "produced_by": {
          "description": "Agent or workflow that produced this output.",
          "title": "Produced By",
          "type": "string"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "workflow_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workflow Version"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "input_refs": {
          "description": "Identifiers of the records and documents used as input.",
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        }
      },
      "required": [
        "produced_by"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SlideSpecification": {
      "additionalProperties": false,
      "description": "One planned slide, independent of the rendering technology.",
      "properties": {
        "extensions": {
          "additionalProperties": true,
          "description": "Faculty- or department-specific fields outside the common core.",
          "title": "Extensions",
          "type": "object"
        },
        "number": {
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "type": {
          "description": "e.g. hook, concept, example, exercise, recap.",
          "title": "Type",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "minutes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minutes"
        },
        "purpose": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purpose"
        },
        "outcomes": {
          "items": {
            "pattern": "^LO-[0-9]{2,3}$",
            "type": "string"
          },
          "title": "Outcomes",
          "type": "array"
        },
        "concepts": {
          "items": {
            "pattern": "^CONCEPT-[A-Z0-9][A-Z0-9-]*$",
            "type": "string"
          },
          "title": "Concepts",
          "type": "array"
        },
        "required_visual": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Visual"
        }
      },
      "required": [
        "number",
        "type",
        "title"
      ],
      "title": "SlideSpecification",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Metadata and a storage pointer. Never the bytes themselves.",
  "properties": {
    "extensions": {
      "additionalProperties": true,
      "description": "Faculty- or department-specific fields outside the common core.",
      "title": "Extensions",
      "type": "object"
    },
    "document_id": {
      "pattern": "^DOC-[A-Z0-9][A-Z0-9-]*$",
      "title": "Document Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "storage_key": {
      "description": "Repository-relative path here; object-storage key in the application.",
      "title": "Storage Key",
      "type": "string"
    },
    "mime_type": {
      "description": "e.g. text/markdown, application/pdf.",
      "title": "Mime Type",
      "type": "string"
    },
    "original_filename": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Original Filename"
    },
    "size_bytes": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Size Bytes"
    },
    "checksum": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "e.g. 'sha256:...'. Filled in on approval when the file exists.",
      "title": "Checksum"
    },
    "uploaded_by": {
      "anyOf": [
        {
          "pattern": "^USER-[A-Z0-9][A-Z0-9-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Uploaded By"
    },
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    },
    "course_version_id": {
      "anyOf": [
        {
          "pattern": "^[A-Z][A-Z0-9]{1,7}-[0-9]{3,5}-[0-9]{4}-(?:FALL|SPRING|SUMMER|WINTER)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Course Version Id"
    },
    "course_id": {
      "anyOf": [
        {
          "pattern": "^[A-Z][A-Z0-9]{1,7}-[0-9]{3,5}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Course Id"
    },
    "module_id": {
      "anyOf": [
        {
          "pattern": "^MODULE-(?:DRAFT-)?[0-9]{2,3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Module Id"
    },
    "concepts": {
      "items": {
        "pattern": "^CONCEPT-[A-Z0-9][A-Z0-9-]*$",
        "type": "string"
      },
      "title": "Concepts",
      "type": "array"
    },
    "version": {
      "default": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "supersedes": {
      "anyOf": [
        {
          "pattern": "^DOC-[A-Z0-9][A-Z0-9-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The document this replaces, e.g. last year's slides.",
      "title": "Supersedes"
    },
    "generated_by": {
      "anyOf": [
        {
          "$ref": "#/$defs/Provenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Set when an agent produced this file, so a reader can tell."
    },
    "presentation_plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/PresentationPlan"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Planning metadata for a slide deck; rendering remains a later step."
    }
  },
  "required": [
    "document_id",
    "title",
    "storage_key",
    "mime_type"
  ],
  "title": "Document",
  "type": "object"
}
